---
import '@fontsource/crimson-pro/latin-400.css';
import '@fontsource/crimson-pro/latin-400-italic.css';
import '@fontsource/crimson-pro/latin-500.css';
import '@fontsource/crimson-pro/latin-600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Gedachten, gedichten en verhalen van Harm Snaphaan.',
} = Astro.props;
const pageTitle = title ? `${title} — Harm` : 'Harm — gedachten, gedichten en verhalen';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Harm" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Naar de homepage">Harm<span aria-hidden="true">.</span></a>
      <nav aria-label="Hoofdnavigatie">
        <a href="/over" aria-current={Astro.url.pathname === '/over/' ? 'page' : undefined}>Over</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Harm Snaphaan</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
